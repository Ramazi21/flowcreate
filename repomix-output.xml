        {pending ? "Регистрация…" : "Зарегистрироваться"}
      </Button>
      <p className="text-center text-sm text-charcoal/70">
        Уже есть аккаунт?{" "}
        <Link href="/signin" className="font-semibold text-[#1f3342] hover:underline">
          Войти
        </Link>
      </p>
    </form>
  );
}
